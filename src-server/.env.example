# StoryMoss Server 环境变量配置
# 复制此文件为 .env 并填写真实值（docker compose 读取同目录 .env 做变量替换）

# ============================================
# 数据库配置 (必需)
# ============================================
POSTGRES_USER=storymoss
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=storymoss

# 服务端直连数据库时使用（compose 中由上面的 POSTGRES_* 自动拼接）
DATABASE_URL=postgres://storymoss:your-secure-password-here@postgres:5432/storymoss

# ============================================
# 服务端配置 (必需)
# ============================================
# JWT 签名密钥（server 自签自验，生产环境务必修改，至少32字符）
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# 监听地址与端口（容器内保持 0.0.0.0:8080）
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 前端URL（用于CORS与OAuth回调跳转）
FRONTEND_URL=https://storymoss.top

# OAuth redirect_uri 的对外 base，必须与 Google/GitHub 后台注册的 callback 一致
SERVER_BASE_URL=https://storymoss.top

# 开发升级通道（开发环境放行订阅升级调试接口；生产置 false）
DEV_UPGRADE_ENABLED=true

# ============================================
# OAuth 配置 (至少配置一个)
# ============================================
# Google OAuth: https://console.cloud.google.com/apis/credentials
# callback: https://storymoss.top/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
# callback: https://storymoss.top/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 微信开放平台 (预留)
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=

# QQ 互联 (预留)
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
